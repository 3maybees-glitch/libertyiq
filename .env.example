# Stripe — LibertyIQ Core / Lifetime
# Live account: acct_1TsIsFEyq5c8DnMY
# POST /api/checkout mode "checkout_session" reads STRIPE_SECRET_KEY plus the three price IDs below.
# Production refuses sk_test_ / rk_test_ keys. Do not point production at a different Stripe account.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID_MONTHLY=price_1TsS6lEyq5c8DnMY7Tlymk7Q
STRIPE_PRICE_ID_YEARLY=price_1TsS6lEyq5c8DnMYwIsf3CZj
STRIPE_PRICE_ID_LIFETIME=price_1TsS6lEyq5c8DnMYBDMTgtIp
STRIPE_WEBHOOK_SECRET=whsec_...

# Signs the Core/Lifetime entitlement cookie (use a long random string in production)
ENTITLEMENT_SECRET=

# Public site URL used in Checkout success/cancel + Customer Portal return
NEXT_PUBLIC_APP_URL=https://libertyiq.org

# Optional live Payment Links, used only when Checkout Sessions are not configured.
# https://buy.stripe.com/test_… links are ignored. Leave unset in production.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_LIFETIME=
STRIPE_PORTAL_CONFIGURATION_ID=
