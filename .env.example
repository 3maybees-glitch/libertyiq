# Stripe — LibertyIQ passes (one-time, no subscription)
# Live account: acct_1TsIsFEyq5c8DnMY
# POST /api/checkout mode "checkout_session" reads STRIPE_SECRET_KEY plus these two price IDs.
# STRIPE_PRICE_ID_FAMILY_PASS and STRIPE_PRICE_ID_GROUP_PASS are no longer read.
# Production refuses sk_test_ / rk_test_ keys.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID_CORE_PASS=price_1UXBabEyq5c8DnMYKhGL2WXi
STRIPE_PRICE_ID_TOPIC_PACK=price_1UXBakEyq5c8DnMYd90WtKFi
STRIPE_WEBHOOK_SECRET=whsec_...

# Signs the Core/Lifetime entitlement cookie (use a long random string in production)
ENTITLEMENT_SECRET=

# Public site URL used in Checkout success/cancel + Customer Portal return
NEXT_PUBLIC_APP_URL=https://libertyiq.org

# Older subscription price IDs and Payment Links are no longer read.
# STRIPE_PRICE_ID_MONTHLY / _YEARLY / _LIFETIME can stay set for your notes; checkout ignores them.
STRIPE_PORTAL_CONFIGURATION_ID=
